# ============================================================
# Sol-Chic — Variables d'environnement
# Copiez ce fichier en .env.local et remplissez les valeurs
# ============================================================

# Supabase (publiques — injectées dans le build Next.js)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ⚠️ Ces valeurs NE VONT PAS dans Next.js — elles sont configurées
# directement dans Supabase Edge Functions via :
#   supabase secrets set GEMINI_API_KEY=...
#
# GEMINI_API_KEY=AIza...
# SUPABASE_SERVICE_ROLE_KEY=eyJ...
# RESEND_API_KEY=re_...
# ADMIN_EMAIL=votre@email.com
